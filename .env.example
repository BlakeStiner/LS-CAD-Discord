# Discord Developer Portal application bot token
DISCORD_TOKEN=

# The application ID from the Discord Developer Portal
DISCORD_CLIENT_ID=

# Optional while developing: registers commands immediately in one server.
# Omit this in production to register global commands.
DISCORD_GUILD_ID=

# Private CAD portal snapshot publisher. Keep the token out of source control.
# The ingest URL is the private portal's /api/operations/ingest route.
PORTAL_INGEST_URL=
PORTAL_INGEST_TOKEN=
