# Discord Developer Portal application bot token
DISCORD_TOKEN=

# The application ID from the Discord Developer Portal
DISCORD_CLIENT_ID=

# Optional while developing: registers commands immediately in one server.
# Omit this in production to register global commands.
DISCORD_GUILD_ID=

# Private CAD portal connection. Keep the token out of source control.
# The ingest URL is the private portal's /api/operations/ingest route. The bot
# reuses the same origin and token to poll the portal's supervisor command
# queue (manual clock-in, clock-out, and reminder requests).
PORTAL_INGEST_URL=
CAD_INGEST_TOKEN=
PORTAL_INGEST_TOKEN=

# Alternatively, set the portal base URL (without a trailing slash) and token.
CAD_PORTAL_URL=
